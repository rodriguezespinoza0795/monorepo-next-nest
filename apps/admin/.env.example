# Variables de entorno de `admin` (panel de moderación). Copia este archivo
# como `.env.local` y completa los valores. Nunca subas `.env.local` al repo.

# --- Stream Activity Feeds: los mismos valores que en `web` ---
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- Sesión compartida con la app principal: los mismos valores que en
# `web` (mismo proyecto de Firebase), salvo `APP_URL` ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SESSION_COOKIE_DOMAIN=
AUTH_LOGIN_URL=http://localhost:3002/login
APP_URL=http://localhost:3001

# --- Administradores: los mismos correos que en `web` (solo ellos entran, y
# solo con el correo verificado) ---
ADMIN_EMAILS=tu-correo@ejemplo.com

# --- Sentry (opcional; https://sentry.io → proyecto Next.js) ---
# Sin DSN queda apagado (lo normal en desarrollo). El DSN es público; el token
# solo hace falta en el build de producción para subir los source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
