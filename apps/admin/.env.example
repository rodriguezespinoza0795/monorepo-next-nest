# Variables de entorno de `admin` (panel de moderación). Copia este archivo
# como `.env.local` y completa los valores. Nunca subas `.env.local` al repo.

# --- Stream Activity Feeds: los mismos valores que en `web` ---
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- Google OAuth: el mismo cliente que en `web` ---
# URI de redirección autorizada: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Better Auth: secreto propio, distinto del de `web` ---
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# --- Administradores: los mismos correos que en `web` (solo ellos entran) ---
ADMIN_EMAILS=tu-correo@ejemplo.com

# --- Sentry (opcional; https://sentry.io → proyecto Next.js) ---
# Sin DSN queda apagado (lo normal en desarrollo). El DSN es público; el token
# solo hace falta en el build de producción para subir los source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
