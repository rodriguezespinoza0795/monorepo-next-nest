# Variables para las pruebas de punta a punta (`pnpm --filter web test:e2e`).
# Copia este archivo como `.env.test.local`. Usa una app de Stream SOLO para
# pruebas: las pruebas crean y borran miembros, publicaciones y comentarios,
# y las publicaciones cuentan para el tope mensual de actividades.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# Opcional: Upstash para probar el límite de frecuencia. Si faltan, se
# toman de `.env.local`; sin ninguno, la prueba de frecuencia se salta.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
