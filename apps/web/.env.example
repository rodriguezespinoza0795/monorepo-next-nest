# Variables de entorno de `web` (la comunidad). Copia este archivo como
# `.env.local` y completa los valores. Nunca subas `.env.local` al repo.

# --- Stream Activity Feeds (https://getstream.io → Dashboard → tu app) ---
# La API key es pública (la usa el navegador); el secreto solo el servidor.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- Sesión compartida con la app principal (www.davidre.dev) ---
# El login vive en la app principal (`apps/main`, Firebase); la comunidad lee
# su cookie de sesión. Las credenciales de Firebase Admin son las del mismo
# proyecto (consola de Firebase → Configuración del proyecto → Cuentas de
# servicio). La clave va entre comillas y con los saltos de línea como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Dominio de la cookie (vacío en local; `.davidre.dev` en producción), para
# poder borrarla al cerrar sesión.
SESSION_COOKIE_DOMAIN=
# Login de la app principal y URL pública de esta app (para volver aquí).
AUTH_LOGIN_URL=http://localhost:3002/login
APP_URL=http://localhost:3000

# --- Administradores: correos separados por coma (pueden publicar en
# espacios solo-admin y entrar al panel de `admin`). Solo cuentan si el correo
# está verificado (Google y enlace mágico lo están; con contraseña, al abrir
# el correo de verificación). ---
ADMIN_EMAILS=tu-correo@ejemplo.com

# --- Upstash Redis (https://console.upstash.com → tu base → REST API) ---
# Límite de frecuencia de publicaciones y comentarios.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry (opcional; https://sentry.io → proyecto Next.js) ---
# Sin DSN queda apagado (lo normal en desarrollo). El DSN es público; el token
# solo hace falta en el build de producción para subir los source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
