# Variables de entorno de `main` (demo de la app principal). Copia este archivo
# como `.env.local` y completa los valores. Nunca subas `.env.local` al repo.

# --- Firebase, app web (consola de Firebase → Configuración del proyecto →
# General → Tus apps). No son secretas: las usa el navegador. ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada). Secretas: solo el servidor. La clave va entre
# comillas y con los saltos de línea escritos como \n. ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Sesión compartida ---
# Dominio de la cookie de sesión. Vacío en local (las cookies de `localhost`
# se comparten entre puertos); en producción `.davidre.dev`, para que la lean
# `community.` y `admin.`.
SESSION_COOKIE_DOMAIN=
# Hosts a los que se puede volver después de iniciar sesión (`?next=`),
# separados por coma. En producción: community.davidre.dev,admin.davidre.dev
ALLOWED_REDIRECT_HOSTS=localhost

# URL de la comunidad (botón "Ir a la comunidad").
NEXT_PUBLIC_COMMUNITY_URL=http://localhost:3000
